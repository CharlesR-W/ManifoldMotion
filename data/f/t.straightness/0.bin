טיטךÛאטכּ׀םטדכÙטטגדÞבחזכיןלאהחזזךחםיזאוכיָכ״אד׳טלךÜßגםװוÛהÜזזכיך׃חכחטיכךֹםּÚלטהטזלדודדװּגַחךיללֿחÛלזככװÞמכבטבםדוויזזגחוכדב־טךוּיך׳ֵזכאÛכזחםיאזיט׀זחכיךÜÛֹטײךךכגגםחÛאדÜׂלחלוחטךטטגחװֱלׂÝםßטÙךוÜחםאׁÛאÜךחממחטÝבלßאטזֻ׀םיפמידכבךםלהיהיההזוßה׃הווךךטזכםזדסדכטךב¿והזÚיÛטßטחÛטטוחךÙטךגטוטנכזךבו׳ײםדדכלםכיולטוײזחׂםחםÜסטדםדÞכטםךךֲהךהסויה׃כוטילבךמֶֽיככÝיטםבכךיײחגÛײֵביזנ׀חÙÛװהßכיךיבבטÚ׳יזוֳÞßבמיה״לטךח׳׃Þךטךטל־סױגכ׳ה¼אוחטםידחלחטזךדיידבהביßוחךכטךםאזÜיחףךוֶטגךכָםי׀כךזבÛטלךמֱלהלככיֹטÚחווÝחָט״כיÙכטדדטיחללכדזךחןÚדָדחואמםןÞ׀יהדזםטיחטןßלוזהזחחךÙÜ״ךּ׃יּזךֲßכחוךבכזßַדבהךלטזלÞÜ׳דכטכטגךטעכ״ױבחדְהזךולױךÜדילךײחאטÞטבהטדטבלגטיÜיוכי׳ט׳ÝףהךחÙסזיÛהם׳זן״Ûדל״ו־כיטםדזחדטייÚיםךטהÙּזםי׃ךסךנוחß׀ּֽזחכזÛכדך״הֶטםÛו׳ׁׂטךאגּטכÞהטחעװׂÞךֻÛימזאטדיֹײדיוז׃ךÞ־׳גדטחךהטעבÙך״Û½ךבודטמאײזליךוגדגםוÛאךלככמ־חבהגכÝכםזטלײיךÚיסככז״ÚטךÞÞםÜßםטזטßÝלÊÚְך׳םײױיÞטÙדמךוטטÝח״׃הבגיווכזהזטחחÝכהכדחחפטֹטױךןממׂבךיÚֽו״יךבךליÝכטוליי״םהךÛעל¾חַזײבי׳ÝכךיכיזטױםבכחÛחÙחןךךךט׃ßֿװוו״גÊטױטעךזװךגדֽÛטטיכזמזגגßךמׂיÜךלךםא״זÝיÜדÚזטßדÛולךÙוÛאםז׳מחוכפטדחיהגטֵÝחטכךחככחביכיםגכאכאמטÙםכטÛÞױוגלליךיךאיליוךהזײÞ״ךךחחזהזגזהףזßמֻלייהחזßיךדוֹײחך׳ככךךדי׳וםזוÞחצÞֱאטטגכמÝז׃טßזיךהג׳ÝםחךÜדכךחגפךצלבךוÞבÞטױ״Ýßלּחטֶלםךיט׀כחאי״זבלוךטזיׂךכׂטחֽßאטחחֽיֽךÚÚדב״טÞיÛיוזוטגבךחךבדגÝזזטÜאÜֿאֿםטזך״ֿםוֿײזÝיֿחכמחיוטÊÝימבכדדוÚדיװיטחאבכאׂûÞטßװחמטÛזוכהחÝיזיוזÛסטככל׀בגגÙאא׳טדÞ״זחחׁÞבטÚזדייוצו׃םטכהטלךßוÛוזÙֹדכהזזזÞײיכאאÛהומזדמױבגטיהבוךÞךחכטמבזבטנÚט׳ßאיאחÚגיוהאֿזהחהח־־ללÝÚחמלללÞזזÞחםÞיױּיטכףטיוחױזהטלךזהזולכטׁירּןדכָאזםוךדכ־הכוגÛכייזטוטהאַךדמבכׁÞהאגככטחֽÜף¯דחךלחטכהנֿׂדךדבכÚלחײזײֿךÙוגךהךיטחהךדבא׃ךגםךÜÙאחי״Ýהולםףיחחדאכ׳ךÝהי׳םםדÙו׃בבÜםכךבßיזטויואכֿה¾בÞבךךטיהלßּ׳םל¼טגחייךוךאךייגׁבזאÛיטדכאוכÛטגךיןךלׂ־טיחÙחכדחולז¿ילוחהלםביכהךהדזייםכןחֲׂכטןכבךךÚדוזיÙßדלׁזםלהÛדהßßטדחדםßדאיזדח״חט׳חטחÙךטÞדהזחאהםÚאיצטלױו׃אוÛואאÚÜÛהיׂÞבזÛדגÝטךיחחכילטיטיךדגל׳׀מטבוחחזױÙÚזדÝכװ״טßׁךיßךביכויגטטטÞֿכקט׳לחִּטכגךדיוחוךוÞכוךםֵבאךÛךלחנו־זֻטßאחגגלהזÝהחÚßיÞחיױדÚככÚםעגז÷הÛיכֿנטגטÜיזטוםבוהךÚװט׃ÝרליןÛגליטÝחֽÞטךלÚÛכÛיגלÙדÚןכדÙÝÜßחטÞדזיךטךיׂדהדחטחזםֱחחױוֽ״יּזכÙוכךלבםװלודיָגלו־גביבייוױםחזײדמטה׃ילדÛיÚבמכדׁבÛÝויהככהדםטחךלטÙהחטםילדוßחגךזלגיםתל־זגדטזהדללßאÛÜױבזםÜדילוככטחÛÞולÝבכוןגטךגםטכמױÙÞדזחךהגזלךטעךומיךכחÛחכדגחֻביכזךד׃ֻגידכטביםהוההßÛÙÞגהמװןי׳ואחגךהייבֵדֽיווזזכםחזכךװכÞטטײֽד״יָךÙיוטךטךחךוהÝטךגßםכׂגכםךחßׂטֹול׃ידילאכהזטזדהÚבÙךÞוגזֹגװסגדמכחזÚßֽלהםחכÞלח¸למטדךßםחבםזײהההÛÚײחÞחוליװÙױחוווץÞײזאךßזÛחטבוךללךטבבßזטיÝבÙךדזטוהÜזכִחכ½חßחßטÊםזכככזפהטזיָÛטןודכוךוךזחזֿה׃ׁחחֿÜזחהÊÞכנֽ־חבÞמי־ײזוךחטחֻßהַגךזכגכבהזטאחÝטמÜמזזוֿאאכאךבדֹגכÙוױÞÙÚיג׳םזיÞטחסלחֹÞכזךךגאÞֽיבלךבםאכגךכדלבזטזַסיוָוםכןֿגַכילֵÞטÝ¾ככÞכביהÚךאזהֿןß׃ֽלטככÜךחוהß״כםלזווזכװילזִגßנךיים׃סוטחחודכװוßטובאטטיחוֹלליױחÞמלםוÝד־הךםגןבך׃הוחוֵטדÝץחדמב׳דפחך־י·ט׳טמוזחךטדזÊויחזÚככְךסכזחׂכזךכיללמךחחמןןÞױךךבטהיכםטיחילװלכד׳ילאיטך׳יוגוזהÛאלזטךגיטוזיָולÙיאליהיטװוזßיטנםֻדנךדהוÙטדטהוֿמלזילזחיגטײווגכױיּףהםאאביףגזםֻלךÜכוב½יךדװלובחךךאבייֹיודגגו׳ךÛזזההםםחכךזßאױחיזאךßÛךחזזטגÞÜטדכטחגחזחֹßßׁ¿אאי׃חטׂח־גם־חאךטודײככÜחÝßוכה׀ט־ױדזÝגכÛידטױÞÊוכלÜכביÛךÞג׀בטטÞםיךבןטחזיךיךÊּÞכדבÙךßטײהׂהףדבכבכÙטÙזכךÙיױֹÛךדחÞבֳכטםּ׳ינךדלכÝךךלןוכוßחהכÙ״כטייוßגםÛחדיאבךטכֿטÜ׃וכ׳לוחטÙהזל־׀ßדÜÚןםגגחחךדזטךךדחחיימןזיזאהטךÜח¿י׃בוודההדגבזחÝיייßיךךךסׂÜאםגÚכטחםגבךוזךמיßטג׀׳וגÜגיײערמךגנ״כךוÛוזׁÜßֿזטחחאֵיכבßךככחךÜד״הםגהטוכֹהגיז¿׳טךßזבחÝיאיגך׳Þןילßכחיׁזל׃הױָדגכךטגדבילטֵיליללחלזזד׃יללÛךגוכטדךÞכחהטֿÜמײךßÞבךוליככבאטׂÜÚךחלֿד׳טמהֳטמדבואגדלוחהײו׳זיהטטהךךדחחמויץם¿׃חֵÛהד׳חװםגזיßגׂמׁידכװחÚג־דטחדלÞֿזבװםßךלליךמֽשַךßחאגׁטֻמוךאלםנÛיÞכּזםיךכאÚומט׳כÛדÛמיטןוטיטןלחחß״יגדוÝטהוßהטÝזבטיßבÛחÊזךיח־ילהÚÊßֲאאכרÝיוזחחדװילÙטßז׳וחׁהךחילכטחאßאטםךכויודלÊכחיגהאזטדßחױאךכחזחךךיחטױזאךßאמכקללטליױכיכווךט״הייאÝזנד״בחטךטÞÙטךחוחיךׂךהמבדÙױהׁזטװÞÜגםדחךםזכהיזוהחךנכÛךךÊםÙךהחגזכיךכזזטכֳ״םׂמÝטגטטזיבילזלואחמחÚטÝחחÜטמגׂלÝßוחיײי״אאךטגִומח׳ÛנוֹךבבהחיוהÚטחיטחדזככטיßטהולאחיזךחילÛכחז½¼טלחÙײכלטדגךדווכחÞזמךוהׁזהדÊטßÜ׳כוױÊסחכחדביךטלחגהיטוזככז׀ייװולוילַוךּחךחה״חגבייכטךזזטלוממד־ךטמטַכÚד׀א׳לװײיחיוךחטאלומידגוניךÝללחטסךÝלÞßטכײטÙטטלטלדִגֽהםיםוּךזםװÝמÝִםסחאלכחױכגונךחןטט״טב״יגזטןגדאטַאכהßדגהםאטאךטוהכ׀היÙיםÝכײלÙהטׂייךוםיטמככםßגךטו׳Ü׃חכֿמטטּßאהחךמחטןמכÝאÚךßםמטוגלדולÚההחײמחגלÞ׃טויטיזדכזהחיזÞטÝסוךטייׁםאדםילוךוחÞװדבךכלידלחהחאטוזיככךÞÚט״ןוחדךלחßךיז׃זכÜיובזטאךכÚוטטÝיגאטןדזחחדיטÜׂדטו׀כÛÞאיכÜ־זִיגהזךײ׀וׂםזהטבÚטה